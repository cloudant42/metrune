# Copy this file to a private env file and replace every replace-me value.
# Do not commit the populated file.

POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
DATABASE_URL=postgres://metrune:replace-me@postgres:5432/metrune

METRUNE_PUBLIC_API_URL=https://metrune.example.com
METRUNE_CLIENT_RELEASE_BASE_URL=https://metrune.example.com/v1/downloads
METRUNE_BOOTSTRAP_EMAIL=admin@example.com
METRUNE_BOOTSTRAP_PASSWORD=replace-me-with-a-long-random-password
METRUNE_DASHBOARD_TOKEN=

# Enable only when the reverse proxy in front of the API overwrites
# X-Forwarded-For. See docs/AUTHORIZATION.md and docs/SECURITY_AND_LOGGING.md.
METRUNE_TRUST_PROXY_HEADERS=true

GRAFANA_ADMIN_PASSWORD=replace-me-with-a-long-random-password
