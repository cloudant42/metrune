# Copy to a private file with mode 0600 and replace every placeholder.
# After the first administrator signs in, clear both bootstrap values and
# recreate the API container. Never commit the populated file.

# Paste released image references from SERVER_IMAGE_MANIFEST.txt. Immutable
# digest references are preferred over tags.
METRUNE_API_IMAGE=ghcr.io/owner/repository-api@sha256:replace-me
METRUNE_WEB_IMAGE=ghcr.io/owner/repository-web@sha256:replace-me

POSTGRES_PASSWORD=replace-me-with-a-long-random-password
CLICKHOUSE_PASSWORD=replace-me-with-a-different-long-random-password
DATABASE_URL=postgres://metrune:replace-me-with-a-long-random-password@postgres:5432/metrune

METRUNE_PUBLIC_API_URL=https://metrune.example.com
METRUNE_PUBLIC_WEB_URL=https://metrune.example.com
# Base64 Ed25519 public key matching the release workflow signing secret.
METRUNE_RELEASE_PUBKEY=replace-with-the-32-byte-base64-release-public-key
# Host directory containing the signed client-manifest.json and artifacts from
# the canonical release. It is mounted read-only into the API container.
METRUNE_CLIENT_RELEASE_DIR=/private/path/metrune-client-release
# Keep this on the server mirror, or pin an explicit client-vX.Y.Z URL. Do not
# use a moving "latest" URL because server and client releases are independent.
METRUNE_CLIENT_RELEASE_BASE_URL=https://metrune.example.com/v1/downloads
# Production never substitutes demo fixtures for live organization data.
METRUNE_ENABLE_DEMO_DATA=0
# Leave empty while rolling out a new client. Raise only after the installation
# views show that active clients meet this semantic-version floor.
METRUNE_MINIMUM_CLIENT_VERSION=
METRUNE_BOOTSTRAP_EMAIL=admin@example.com
METRUNE_BOOTSTRAP_PASSWORD=replace-me-with-a-long-random-password
METRUNE_BOOTSTRAP_ORGANIZATION=Example Engineering

# Enterprise SSO is optional but fail-closed: set the issuer, client ID, and
# both secret-file paths together. When enabled, leave
# METRUNE_BOOTSTRAP_PASSWORD empty; the bootstrap email is linked on its first
# verified OIDC sign-in. Without these values, local passwords remain enabled.
# METRUNE_OIDC_ISSUER_URL=https://idp.example.com/realms/engineering
# METRUNE_OIDC_CLIENT_ID=metrune
# METRUNE_OIDC_CLIENT_SECRET_HOST_FILE=/private/path/metrune-oidc-client-secret
# METRUNE_OIDC_CLIENT_SECRET_FILE=/run/secrets/metrune-oidc-client-secret
# METRUNE_OIDC_PROVIDER_NAME=Company SSO
# METRUNE_OIDC_PROVISIONING=default-org
# METRUNE_OIDC_DEFAULT_ORGANIZATION=Example Engineering
# METRUNE_OIDC_DEFAULT_ROLE=viewer
# METRUNE_OIDC_SESSION_TTL_HOURS=12

# The supported edge is an HTTPS reverse proxy on the same host. Keep this true
# only when the proxy overwrites X-Forwarded-For.
METRUNE_TRUST_PROXY_HEADERS=false

# Production SMTP must authenticate over certificate-verified STARTTLS or
# implicit TLS. Invitation/reset tokens are delivered by email; passwords are
# never emailed.
METRUNE_SMTP_HOST=smtp.example.com
METRUNE_SMTP_PORT=587
METRUNE_SMTP_USERNAME=replace-me
METRUNE_SMTP_PASSWORD=replace-me
METRUNE_SMTP_FROM=Metrune <metrune@example.com>
METRUNE_SMTP_SECURITY=starttls
