# Optional native-client path and behavior overrides. Server, installation,
# pseudonym, user/team, and project-alias values live in the private config
# written by `metrune enroll`; there is no plaintext token environment path.
METRUNE_CONFIG=
METRUNE_STATE_DB=
# Set to 1 to suppress the once-per-24-hours update notice. The client never
# installs an update automatically.
METRUNE_NO_UPDATE_CHECK=0
# `folder` sends only the final folder name as the project label; `anonymous` sends no readable label.
METRUNE_PROJECT_MODE=folder
METRUNE_PRICEBOOK=/path/to/company-pricebook.json

# Server/browser identity and server-side default pricing.
METRUNE_ENV=development
METRUNE_BOOTSTRAP_EMAIL=admin@test.com
METRUNE_BOOTSTRAP_PASSWORD=admin
METRUNE_BOOTSTRAP_ORGANIZATION=Acme Engineering
METRUNE_DEFAULT_PRICE_CATALOG=/usr/share/metrune/pricing/openrouter.catalog.json
METRUNE_PUBLIC_API_URL=http://localhost:8080
# Browser origin used in CLI device-approval links.
METRUNE_PUBLIC_WEB_URL=http://localhost:3001
# Optional enforced upload floor. Leave empty during a client rollout, then set
# a complete semantic version only after fleet telemetry shows readiness.
METRUNE_MINIMUM_CLIENT_VERSION=
# Optional deployment-wide OpenID Connect. Configure every required value or
# leave all of them empty; partial configuration stops the API at startup.
# Password login and password reset are disabled whenever OIDC is configured.
# The direct secret variable is development-only. Production must use the
# mode-0600 file variable shown in deploy/compose/production.env.example.
METRUNE_OIDC_ISSUER_URL=
METRUNE_OIDC_CLIENT_ID=
METRUNE_OIDC_CLIENT_SECRET=
METRUNE_OIDC_PROVIDER_NAME=Single sign-on
METRUNE_OIDC_PROVISIONING=none
# Required only for `default-org`; use an organization UUID or exact name.
METRUNE_OIDC_DEFAULT_ORGANIZATION=
METRUNE_OIDC_DEFAULT_ROLE=viewer
METRUNE_OIDC_SESSION_TTL_HOURS=12
# Where the web app links client downloads. Point it at this server's mirror
# (docs/CLIENT_DISTRIBUTION.md), or at an explicit client-vX.Y.Z release URL;
# never use a moving server/client "latest" URL for production.
METRUNE_CLIENT_RELEASE_BASE_URL=http://localhost:8080/v1/downloads
# Mirror cache the API serves clients from. It must hold client-manifest.json
# from the release; artifacts it does not hold stay pointed upstream.
METRUNE_CLIENT_DOWNLOAD_DIR=/usr/share/metrune/downloads

# Per-identity and per-address rate limits. Set a value to 0 to disable that
# limit. See docs/AUTHORIZATION.md for the full table.
METRUNE_RATE_LIMIT_ENROLL_PER_MINUTE=10
METRUNE_RATE_LIMIT_LOGIN_PER_MINUTE=30
METRUNE_RATE_LIMIT_PROVISION_PER_MINUTE=20
METRUNE_RATE_LIMIT_CLASSIFY_PER_MINUTE=60
METRUNE_RATE_LIMIT_INGEST_PER_MINUTE=60
METRUNE_RATE_LIMIT_ANALYTICS_PER_MINUTE=120
METRUNE_RATE_LIMIT_ENROLLMENT_CODES_PER_HOUR=20
METRUNE_RATE_LIMIT_DEVICE_AUTHORIZATIONS_PER_MINUTE=10
METRUNE_RATE_LIMIT_DEVICE_VERIFICATIONS_PER_HOUR=60
METRUNE_RATE_LIMIT_DEVICE_TOKEN_POLLS_PER_MINUTE=300
METRUNE_RATE_LIMIT_INVITATIONS_PER_HOUR=30
METRUNE_RATE_LIMIT_PASSWORD_RESETS_PER_HOUR=10
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
# Otherwise clients can forge the header and evade address-keyed limits.
METRUNE_TRUST_PROXY_HEADERS=false

# SMTP is optional in development and production. Without it, invitations
# return manual links and password reset is unavailable. Only `starttls` and `tls` are accepted;
# plaintext SMTP is intentionally unsupported.
METRUNE_SMTP_HOST=
METRUNE_SMTP_PORT=
METRUNE_SMTP_USERNAME=
METRUNE_SMTP_PASSWORD=
METRUNE_SMTP_FROM=
METRUNE_SMTP_SECURITY=

# Optional classifier configuration provisioned by the server to clients.
# `local` keeps semantic text on the client and provisions the key when needed.
# `managed` sends bounded semantic text to Metrune and never returns the key.
METRUNE_CLASSIFIER_EXECUTION_MODE=local
METRUNE_CLASSIFIER_PROVIDER_ID=openrouter
METRUNE_CLASSIFIER_CREDENTIAL_ID=openrouter
METRUNE_CLASSIFIER_ENDPOINT=http://localhost:11434/v1/chat/completions
METRUNE_CLASSIFIER_MODEL=qwen3:4b
METRUNE_CLASSIFIER_API_KEY=
METRUNE_CLASSIFIER_CONFIG_VERSION=dev-1
METRUNE_CLASSIFIER_RESPONSE_MODE=auto
